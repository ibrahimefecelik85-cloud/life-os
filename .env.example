# Life OS — rutin bildirimleri için gereken ortam değişkenleri.
# Bu dosya sadece ÖRNEK; gerçek değerleri Vercel → Project → Settings → Environment Variables'a gir.
# Gerçek değerleri asla GitHub'a gönderme.

# Bildirim anahtarları: life-os klasöründe `npx web-push generate-vapid-keys` ile üret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İletişim adresi (bildirim servisleri sorun olursa buraya yazar), ör. mailto:adin@ornek.com
VAPID_SUBJECT=

# Zamanlayıcı (cron-job.org) şifresi: uzun rastgele bir metin
CRON_SECRET=

# Bulut senkronizasyonu şifresi: telefon ve bilgisayarda "Bağlan" derken bu şifreyi gireceksin
SYNC_PASSWORD=

# Upstash Redis — Vercel → Storage → Upstash for Redis ile bağlarsan bunlar kendiliğinden eklenir
KV_REST_API_URL=
KV_REST_API_TOKEN=
